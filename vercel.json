{
  "functions": {
    "api/produto.js": {
      "includeFiles": "{site.html,produtos.json,js/config.js}"
    },
    "api/sitemap.js": {
      "includeFiles": "{produtos.json,js/config.js}"
    },
    "api/pagina.js": {
      "includeFiles": "{site.html,produtos.json,js/config.js}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/pagina"
    },
    {
      "source": "/index.html",
      "destination": "/api/pagina"
    },
    {
      "source": "/fe",
      "destination": "/api/pagina?tela=fe"
    },
    {
      "source": "/com-seu-nome",
      "destination": "/api/pagina?tela=com-seu-nome"
    },
    {
      "source": "/loja",
      "destination": "/api/pagina?tela=loja"
    },
    {
      "source": "/encomendas",
      "destination": "/api/pagina?tela=encomendas"
    },
    {
      "source": "/produto/:id",
      "destination": "/api/produto?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
